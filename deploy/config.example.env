# hf-cache-d example configuration. Copy to .env (or export these) and fill
# in real values. This file contains placeholders only — no real secrets.

# HTTP listen address for the service.
LISTEN_ADDR=:8080

# S3 backend (required). S3_ENDPOINT must include scheme and port and point
# at an S3-compatible gateway; path-style addressing is always used.
S3_ENDPOINT=http://s3.example.internal:8333
S3_BUCKET=hf-cache
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me

# Hugging Face Hub upstream used to fill cache misses.
HF_UPSTREAM=https://huggingface.co

# Bearer token protecting the push lane. Leave empty to disable pushing
# entirely (the service logs a warning at startup when empty).
PUSH_TOKEN=replace-me-or-leave-empty
